# --- Load Libraries ---
library(GSVA)
library(biomaRt)
library(ggplot2)
library(dplyr)
library(msigdbr)

# --- 1. Read and Clean Data ---
gene_data <- read.csv("gene_fpkm_group.csv", 
                      header = TRUE, 
                      row.names = 1, 
                      check.names = FALSE,
                      stringsAsFactors = FALSE)

# --- 2. Select Only Target Samples ---
target_samples <- grep("^CC[1-3]$|^CCM[1-3]$", colnames(gene_data), value = TRUE)
gene_data_subset <- gene_data[, target_samples]

# --- 3. Prepare Expression Matrix ---
expr_matrix <- as.matrix(gene_data_subset)
mode(expr_matrix) <- "numeric"
expr_matrix[is.na(expr_matrix)] <- 0
expr_matrix <- expr_matrix[rowSums(expr_matrix) > 0, ]
expr_matrix <- log2(expr_matrix + 1)  # log-transform FPKM

# --- 4. Map Ensembl IDs to HGNC Symbols if Needed ---
if(any(grepl("^ENSG", rownames(expr_matrix)))) {
  ensembl <- useEnsembl(biomart = "genes", dataset = "hsapiens_gene_ensembl")
  mapping <- getBM(
    attributes = c("ensembl_gene_id", "hgnc_symbol"),
    filters = "ensembl_gene_id",
    values = rownames(expr_matrix),
    mart = ensembl
  )
  mapping <- mapping[mapping$hgnc_symbol != "", ]
  common_ids <- intersect(rownames(expr_matrix), mapping$ensembl_gene_id)
  expr_matrix <- expr_matrix[common_ids, ]
  rownames(expr_matrix) <- mapping$hgnc_symbol[match(common_ids, mapping$ensembl_gene_id)]
}

# --- 5. Filter for Variance and Remove Duplicates ---
expr_matrix <- expr_matrix[!duplicated(rownames(expr_matrix)), ]
expr_matrix <- expr_matrix[apply(expr_matrix, 1, var) > 0, ]

# --- 6. Load Hallmark EMT Gene Set ---
h_df <- msigdbr(species = "Homo sapiens", category = "H")
emt_genes <- h_df %>% 
  filter(gs_name == "HALLMARK_EPITHELIAL_MESENCHYMAL_TRANSITION") %>% 
  pull(gene_symbol)

emt_sets <- list(
  EMT_Hallmark = intersect(emt_genes, rownames(expr_matrix))
)

# --- 7. Run GSVA ---
gsva_scores <- gsva(expr_matrix, emt_sets, method = "gsva", kcdf = "Gaussian", verbose = FALSE)
emt_score <- gsva_scores["EMT_Hallmark", ]

# --- 8. Prepare Data for Plotting ---
emt_plot_df <- data.frame(
  Sample = names(emt_score),
  EMT_Score = emt_score
) %>% 
  mutate(Group = ifelse(grepl("^CC[1-3]$", Sample), "CC", "CCM"),
         Group_Label = recode(Group,
                              "CC" = "MCF7",
                              "CCM" = "MCF7+CM"))

emt_plot_df$Group_Label <- factor(emt_plot_df$Group_Label,
                                  levels = c("MCF7", "MCF7+CM"))

# --- 9. Statistical Test ---
t_res <- t.test(EMT_Score ~ Group, data = emt_plot_df, var.equal = TRUE)
p_val <- t_res$p.value
p_label <- if(p_val < 0.001) "***" else if(p_val < 0.01) "**" else if(p_val < 0.05) "*" else "ns"
p_text <- paste0("p = ", format.pval(p_val, digits = 3), " (", p_label, ")")

# --- 10. Plot GSVA Scores ---
y_max <- max(emt_plot_df$EMT_Score)
y_range <- diff(range(emt_plot_df$EMT_Score))
y_max <- max(emt_plot_df$EMT_Score)
y_range <- diff(range(emt_plot_df$EMT_Score))

ggplot(emt_plot_df, aes(x = Group_Label, y = EMT_Score, fill = Group)) +
  geom_hline(yintercept = 0, linetype = "dashed", color = "grey70") +
  geom_boxplot(width = 0.4, alpha = 0.5, color = "black", outlier.shape = NA) +
  geom_point(size = 4, shape = 21, stroke = 1, color = "black",
             position = position_jitter(width = 0.05, seed = 42)) +
  
  # Significance bracket
  annotate("segment", x = 1, xend = 2, y = y_max + (y_range * 0.1), 
           yend = y_max + (y_range * 0.1), linewidth = 1) + # Slightly thicker line
  
  # P-value: size 8 is significantly larger for annotations
  annotate("text", x = 1.5, y = y_max + (y_range * 0.18), 
           label = p_text, size = 8, fontface = "bold") + 
  
  scale_fill_manual(values = c("CC" = "#377eb8", "CCM" = "#e41a1c")) +
  labs(title = "", y = "GSVA Enrichment Score", x = "") +
  
  # Base size 20 scales everything up globally
  theme_classic(base_size = 20) + 
  theme(
    text = element_text(face = "bold"),
    axis.title.y = element_text(size = 22, margin = margin(r = 15)),
    axis.text = element_text(size = 20, color = "black"),
    # Add extra margin to the plot to prevent text clipping
    plot.margin = margin(t = 20, r = 10, b = 10, l = 10),
    legend.position = "none"
  )

# Save the plot with high resolution
# The 'plot = last_plot()' ensures it grabs the ggplot you just created


# Also saving as a PNG for easy presentation/web use
ggsave(
  filename = "EMT_GSVA_Boxplot_MCF7+CMvsMCF7.png", 
  width = 7, 
  height = 7, 
  units = "in", 
  dpi = 300
)

# =========================
# HEATMAP OF TOP EMT GENES
# =========================
library(pheatmap)

# --- Extract EMT gene expression ---
emt_gene_expr <- expr_matrix[emt_sets$EMT_Hallmark, ]

# --- Correlation with GSVA score ---
cor_scores <- apply(emt_gene_expr, 1, function(x) cor(x, emt_score, method = "pearson"))

# --- Select top 10 UP (positive correlation) ---
top_up_genes <- names(sort(cor_scores, decreasing = TRUE))[1:10]

# --- Select top 10 DOWN (negative correlation) ---
top_down_genes <- names(sort(cor_scores, decreasing = FALSE))[1:10]

# --- Combine genes (up first, then down) ---
top_genes <- c(top_up_genes, top_down_genes)

# --- Subset matrix ---
heatmap_matrix <- emt_gene_expr[top_genes, ]

# --- Row-wise z-score scaling ---
heatmap_matrix_scaled <- t(scale(t(heatmap_matrix)))


# --- Annotation for samples (use Group directly) ---
# --- 1. Rename the columns of your scaled matrix ---
# This changes "CC1, CC2, CC3" to "MCF7+CMvsMCF7" and "CC1, CC2, CC3" to "MCF7"
# --- 1. Define your labels manually ---
# This ensures the bottom labels are exactly what you want
column_labels <- c("MCF7_1", "MCF7_2", "MCF7_3", "MCF7+CM_1", "MCF7+CM_2", "MCF7+CM_3")


# --- 4. Plot heatmap with labels_col ---
pheatmap(
  heatmap_matrix_scaled,
  cluster_rows = TRUE,
  cluster_cols = FALSE, 
  show_rownames = TRUE,
  show_colnames = TRUE,
  labels_col = column_labels, # <--- THIS FORCES THE LABELS
  fontsize_row = 15,
  fontsize_col = 15,          # Adjust this if labels are too small/large
  angle_col = "45",           # Tilts labels to prevent overlapping
  main = "",
  filename = "EMT_GSVA_heatmap_MCF7vsMCF7+CM.png",
  width = 6,
  height = 8
)

write.csv(heatmap_matrix_scaled, "heatmap_MCF7vsMCF7+CM.csv")
write.csv(emt_plot_df, "EMTscore_MCF7vsMCF7+CM.csv")


