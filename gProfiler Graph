library(dplyr)
library(ggplot2)
library(stringr)
library(forcats)
library(tools)

# 1. Load the data
input_file <- "gProfiler_up_classified_representatives_final.csv"
file_base <- file_path_sans_ext(input_file)
gprof_sorted <- read.csv(input_file, stringsAsFactors = FALSE)

# Optional: remove exact duplicate rows
gprof_sorted <- gprof_sorted %>%
  distinct(source, term_name, .keep_all = TRUE)

# -----------------------------
# Helper function (FIXED)
# -----------------------------
apply_grouped_order <- function(df) {
  df %>%
    arrange(source, log_pval) %>%
    mutate(
      term_id = paste0(term_name, "_", row_number()),   # unique internal ID
      term_ordered = factor(term_id, levels = term_id)
    )
}

# -----------------------------
# GO (BP, MF, CC)
# -----------------------------
df_go <- gprof_sorted %>%
  filter(source %in% c("GO:BP", "GO:MF", "GO:CC")) %>%
  group_by(source) %>%
  group_modify(~ {
    n <- switch(.y$source,
                "GO:BP" = 30,
                "GO:MF" = 15,
                "GO:CC" = 15)
    head(.x, n)
  }) %>%
  ungroup() %>%
  apply_grouped_order()

# -----------------------------
# BP only (FIXED)
# -----------------------------
df_bp <- gprof_sorted %>%
  filter(source == "GO:BP") %>%
  head(30) %>%
  mutate(
    term_id = paste0(term_name, "_", row_number()),
    term_ordered = fct_reorder(term_id, log_pval)
  )

# -----------------------------
# Pathways (KEGG + REAC) (FIXED)
# -----------------------------
df_pathways <- gprof_sorted %>%
  filter(source %in% c("KEGG", "REAC")) %>%
  group_by(source) %>%
  slice_head(n = 20) %>%
  ungroup() %>%
  apply_grouped_order()

# -----------------------------
# Label cleaner (IMPORTANT)
# -----------------------------
clean_labels <- function(x) {
  str_wrap(gsub("_[0-9]+$", "", x), width = 80)
}

# -----------------------------
# Plotting
# -----------------------------
plot_go <- ggplot(df_go, aes(x = term_ordered, y = log_pval, fill = source)) +
  geom_bar(stat = "identity", width = 0.7) +
  coord_flip() +
  scale_x_discrete(labels = clean_labels) +
  labs(x = "GO Term", y = "-log10(adj p-value)") +
  scale_fill_manual(values = c("GO:BP" = "orange", "GO:MF" = "pink", "GO:CC" = "yellow")) +
  theme_minimal(base_size = 14)

plot_bp <- ggplot(df_bp, aes(x = term_ordered, y = log_pval, fill = source)) +
  geom_bar(stat = "identity", width = 0.7) +
  coord_flip() +
  scale_x_discrete(labels = clean_labels) +
  labs(x = "GO Term", y = "-log10(adj p-value)") +
  scale_fill_manual(values = c("GO:BP" = "orange")) +
  theme_minimal(base_size = 14)

plot_path <- ggplot(df_pathways, aes(x = term_ordered, y = log_pval, fill = source)) +
  geom_bar(stat = "identity", width = 0.7) +
  coord_flip() +
  scale_x_discrete(labels = clean_labels) +
  labs(x = "Pathway", y = "-log10(adj p-value)") +
  scale_fill_manual(values = c("KEGG" = "lightblue", "REAC" = "lightgreen")) +
  theme_minimal(base_size = 14)

# -----------------------------
# Save
# -----------------------------
bar_height <- 0.35
plot_width <- 12 

ggsave(paste0(file_base, "_BP_top.png"),
       plot_bp,
       width = plot_width,
       height = nrow(df_bp) * bar_height,
       units = "in")

ggsave(paste0(file_base, "_GO_top.png"),
       plot_go,
       width = plot_width,
       height = nrow(df_go) * bar_height,
       units = "in")

ggsave(paste0(file_base, "_Pathway.png"),
       plot_path,
       width = plot_width,
       height = nrow(df_pathways) * bar_height,
       units = "in")
